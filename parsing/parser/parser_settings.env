
# Параметры очереди RabbitMQ
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_IP=rabbitmq
RABBITMQ_PORT=5672

QUEUE_HTML_PARSING_REQUEST=html_parser_queue_request
QUEUE_HTML_PARSING_RESPONSE=html_parser_queue_response
QUEUE_HTML_PREPROCESSING_REQUEST=html_preprocessing_queue_request
QUEUE_HTML_PREPROCESSING_RESPONSE=html_preprocessing_queue_response


# Параметры парсера html
# Максимальное количество одновременно обрабатываемых страниц (~ создаваемых контекстов)
MAX_PLAYWRIGHT_CONTEXTS_CONCURRENCY=3
# Максимальное количество одновременно сохраняемых картинок со всех страниц (защита системы от перегрузки)
MAX_IMG_SAVE_CONCURRENCY_GLOBAL=20


# Параметры предобработки html
# Максимальное количество одновременно обрабатываемых html файлов
MAX_CONCURRENT_PREPROCESSING=2
