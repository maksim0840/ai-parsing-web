# Параметры очереди RabbitMQ
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_IP=localhost
RABBITMQ_PORT=5673

QUEUE_TEXT_RECOGNITION_REQUEST=text_recognition_queue_request
QUEUE_TEXT_RECOGNITION_RESPONSE=text_recognition_queue_response


# Параметры распознования текста с изображения
# Максимальное количество одновременно обрабатываемых картинок для извлечения текста
MAX_CONCURRENT_TEXT_RECOGNITION=1