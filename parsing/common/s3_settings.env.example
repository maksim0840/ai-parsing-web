# Параметры S3 хранилища
S3_ACCESS_KEY=<CHANGE_ME_ACCESS_KEY>
S3_SECRET_KEY=<CHANGE_ME_SECRET_ACCESS_KEY>
S3_ENDPOINT_URL=http://garage:3900
S3_ADDRESSING_STYLE=path
S3_REGION_NAME=garage

S3_TIME_TO_LIVE_FLAG=True
DEFAULT_BUCKET_NAME=garage-default-bucket
CUSTOM_TTL_BUCKET_NAME=garage-custom-ttl-bucket
